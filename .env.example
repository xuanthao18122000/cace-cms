# Để trống: gọi /api cùng origin, Vite proxy sang cace-api.
# Đích proxy khi dev (mặc định như dưới):
# VITE_API_PROXY=http://localhost:4000
# VITE_UPLOAD_PROXY=http://localhost:4002
# Build triển khai khác origin (không khuyến nghị vì cookie refresh):
# VITE_API_BASE_URL=https://api.example.com/api
